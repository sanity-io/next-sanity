# `cp .env.local.example .env.local` and adjust as needed
SANITY_STUDIO_PROJECT_ID="pv8y60vp"
SANITY_STUDIO_DATASET="production"
# Deploy token for the Vercel build (`sanity schema deploy`). Not used by `sanity dev`.
# SANITY_AUTH_TOKEN=""
# The Next.js app that Presentation previews. Defaults to apps/mvp on http://localhost:3000.
# Vercel preview and production deployments use the related `next-sanity` project instead.
# SANITY_STUDIO_PREVIEW_ORIGIN="http://localhost:3000"
