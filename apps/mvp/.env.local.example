# Setup env by running `npx vercel link && npx vercel env pull` in your cli
# If you don't have access to the Vercel deploy then `cp .env.local.example .env.local` and set these up manually
NEXT_PUBLIC_SANITY_PROJECT_ID="pv8y60vp"
NEXT_PUBLIC_SANITY_DATASET="production"
# Used for Preview Mode, it's exposed clientside for those who launch the preview pages/api/preview
# SANITY_API_READ_TOKEN=...
# Optional, shared with the Sanity Function in ./functions/invalidate-sync-tags so it can sign requests to
# /api/revalidate. Generate one with `openssl rand -hex 32`.
# SANITY_REVALIDATE_SECRET=
# Optional, set to "true" once that function is deployed to hold live events back until the cache has been
# invalidated (<SanityLive waitFor="function">). Leave unset for local development.
# SANITY_LIVE_WAIT_FOR_FUNCTION=
