# Setup env by running `npx vercel link && npx vercel env pull` in your cli
# If you don't have access to the Vercel deploy then `cp .env.local.example .env.local` and set these up manually
NEXT_PUBLIC_SANITY_PROJECT_ID="pv8y60vp"
NEXT_PUBLIC_SANITY_DATASET="production"
# Used for Preview Mode, it's exposed clientside for those who launch the preview pages/api/preview
# SANITY_API_READ_TOKEN=...
# Optional. The Sanity Function in ./functions/invalidate-sync-tags signs its requests to /api/revalidate with it.
# Generate one with `openssl rand -hex 32`.
# SANITY_REVALIDATE_SECRET=
# Optional. Only `sanity blueprints deploy` and `sanity functions test` read it. It is the deployed site's
# route URL, for example https://your-site.vercel.app/api/revalidate
# REVALIDATE_URL=
# Optional. Set to "true" once that function is deployed. <SanityLive waitFor="function"> then holds live
# events back until the cache has been invalidated. Leave unset for local development.
# SANITY_LIVE_WAIT_FOR_FUNCTION=
